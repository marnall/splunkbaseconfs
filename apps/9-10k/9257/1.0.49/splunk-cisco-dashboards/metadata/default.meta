
[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

# Backgrounds are shared renderer inputs. Delegated managers use the
# capability-protected handler, while direct raw config writes are restricted
# to trusted application administrators.
[templates]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# Shared topology mutations follow the same capability-protected path. Keep
# raw generic-conf writes administrator-only so power cannot bypass validation.
[customer_topology]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[macros/dnac_site_normalize%281%29]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system

# The index abstraction is a shared contract used by searches harvested from
# companion Cisco apps. Keep the definitions owned here, but make every
# no-argument index_* macro resolve from any dispatch context.
[macros/scd_summariesonly]
access = read : [ * ], write : [ admin, power, sc_admin ]
export = system

