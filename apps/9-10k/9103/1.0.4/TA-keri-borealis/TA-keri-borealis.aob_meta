{"basic_builder": {"appname": "TA-keri-borealis", "friendly_name": "Keri Borealis", "version": "1.0.4", "author": "Karl Cepull", "description": "This add-on uses the API from Keri for the Borealis door access (badge reader) platform to ingest live events.", "theme": "#65A637", "large_icon": "", "small_icon": "", "visible": true, "tab_version": "4.5.1", "tab_build_no": "0", "build_no": 7}, "data_input_builder": {"datainputs": [{"index": "default", "sourcetype": "borealis", "interval": "30", "use_external_validation": true, "streaming_mode_xml": true, "name": "keri_aetheros_borealis", "title": "Keri Aetheros Borealis", "description": "Events from the Borealis door access management system by Keri.", "type": "customized", "parameters": [{"name": "base_url", "label": "Base URL", "help_string": "Enter the base URL for the Keri API endpoint.", "required": true, "format_type": "text", "default_value": "https://apikeri-modern.aetheros.net", "placeholder": "", "type": "text", "value": "https://apikeri-modern.aetheros.net"}, {"name": "credentials", "label": "Credentials", "help_string": "Choose the credentials to use to authenticate.", "required": true, "possible_values": [], "format_type": "global_account", "default_value": "", "placeholder": "", "type": "global_account", "value": "account0"}, {"name": "tenant_name", "label": "Tenant/System Name", "help_string": "Enter the Name of the Tenant. This can be found on the \"Manage Systems\" page in the Borealis UI.", "required": true, "format_type": "text", "default_value": "", "placeholder": "", "type": "text", "value": "Tek Stream"}, {"name": "site_name", "label": "Site Name", "help_string": "Enter the name of the Site from Sites page in the Borealis UI.", "required": true, "format_type": "text", "default_value": "", "placeholder": "", "type": "text", "value": "TekStream"}, {"name": "page_size", "label": "Page Size", "help_string": "Retrieve events in blocks of this size.", "required": true, "format_type": "text", "default_value": "1000", "placeholder": "", "type": "text", "value": "1000"}, {"name": "timeout", "label": "Timeout (seconds)", "help_string": "Enter the timeout, in seconds, to wait for events to be returned from Borealis. (NOTE: On initial load of historical events, this could take many minutes due the size of the data.)", "required": false, "format_type": "text", "default_value": "30", "placeholder": "", "type": "text", "value": "30"}, {"name": "timestamp_start", "label": "Load Events Starting From", "help_string": "On initial load, only retrieve events starting from this timestamp. ISO 8601 format (e.g. \"2026-07-11T18:30:00-04:00\")", "required": false, "format_type": "text", "default_value": "", "placeholder": "", "type": "text", "value": "2026-07-01T00:00:00+00:00"}], "data_inputs_options": [{"type": "customized_var", "name": "base_url", "title": "Base URL", "description": "Enter the base URL for the Keri API endpoint.", "required_on_edit": false, "required_on_create": true, "format_type": "text", "default_value": "https://apikeri-modern.aetheros.net", "placeholder": ""}, {"type": "customized_var", "name": "credentials", "title": "Credentials", "description": "Choose the credentials to use to authenticate.", "required_on_edit": false, "required_on_create": true, "possible_values": [], "format_type": "global_account", "default_value": "", "placeholder": ""}, {"type": "customized_var", "name": "tenant_name", "title": "Tenant/System Name", "description": "Enter the Name of the Tenant. This can be found on the \"Manage Systems\" page in the Borealis UI.", "required_on_edit": false, "required_on_create": true, "format_type": "text", "default_value": "", "placeholder": ""}, {"type": "customized_var", "name": "site_name", "title": "Site Name", "description": "Enter the name of the Site from Sites page in the Borealis UI.", "required_on_edit": false, "required_on_create": true, "format_type": "text", "default_value": "", "placeholder": ""}, {"type": "customized_var", "name": "page_size", "title": "Page Size", "description": "Retrieve events in blocks of this size.", "required_on_edit": false, "required_on_create": true, "format_type": "text", "default_value": "1000", "placeholder": ""}, {"type": "customized_var", "name": "timeout", "title": "Timeout (seconds)", "description": "Enter the timeout, in seconds, to wait for events to be returned from Borealis. (NOTE: On initial load of historical events, this could take many minutes due the size of the data.)", "required_on_edit": false, "required_on_create": false, "format_type": "text", "default_value": "30", "placeholder": ""}, {"type": "customized_var", "name": "timestamp_start", "title": "Load Events Starting From", "description": "On initial load, only retrieve events starting from this timestamp. ISO 8601 format (e.g. \"2026-07-11T18:30:00-04:00\")", "required_on_edit": false, "required_on_create": false, "format_type": "text", "default_value": "", "placeholder": ""}], "code": "\n# encoding = utf-8\n\nimport os\nimport sys\nimport time\nimport datetime\nimport json\nimport urllib.parse\n\n'''\n    IMPORTANT\n    Edit only the validate_input and collect_events functions.\n    Do not edit any other part in this file.\n    This file is generated only once when creating the modular input.\n'''\n'''\n# For advanced users, if you want to create single instance mod input, uncomment this method.\ndef use_single_instance_mode():\n    return True\n'''\n\nclass BorealisClient:\n    def __init__(self, helper, ew, base_url: str, client_id: str, client_secret: str, tenant_name: str, site_name: str, last_timestamp: str = None):\n        self.helper = helper\n        self.ew = ew\n        self.base_url = base_url.rstrip(\"/\")\n        self.client_id = client_id\n        self.client_secret = client_secret\n        self.tenant_name = tenant_name\n        self.site_name = site_name\n        self.last_timestamp = last_timestamp\n        #self.session = requests.Session()\n\n        self.auth_token = None\n        self.tenant_key = None\n        self.site_id = None\n\n    def connect_token(self) -> str:\n        \"\"\"POST /connect/token -- client_credentials grant, no auth.\"\"\"\n        url = f\"{self.base_url}/connect/token\"\n        headers = {\"Content-Type\": \"application/x-www-form-urlencoded\"}\n        data = {\n            \"client_secret\": self.client_secret,\n            \"client_id\": self.client_id,\n            \"grant_type\": \"client_credentials\",\n        }\n        self.helper.log_debug(\"Obtaining access token...\")\n        #resp = self.session.post(url, headers=headers, data=data)\n        resp = self.helper.send_http_request(url, method=\"POST\", parameters=None, \n            payload=urllib.parse.urlencode(data), headers=headers, cookies=None, \n            verify=True, cert=None, timeout=None, use_proxy=True)\n        if not resp.ok:\n            self.helper.log_error(resp.text)\n            #self.helper.log_error(\"Request.body=\" + str(resp.request.body))\n            #self.helper.log_error(\"Request.headers=\" + str(resp.request.headers))\n        resp.raise_for_status()\n        self.auth_token = resp.json()[\"access_token\"]\n        self.helper.log_debug(\"Access token = \" + self.auth_token)\n        return self.auth_token\n\n    def get_tenant_key(self) -> str:\n        \"\"\"GET /api/master/tenants/my/list -- bearer auth.\"\"\"\n        url = f\"{self.base_url}/api/master/tenants/my/list\"\n        headers = {\n            \"Content-Type\": \"application/json\",\n            \"Authorization\": f\"Bearer {self.auth_token}\",\n        }\n        self.helper.log_debug(\"Retrieving Tenant Key...\")\n        resp = self.helper.send_http_request(url, method=\"GET\", parameters=None, payload=None,\n                                        headers=headers, cookies=None, verify=True, cert=None,\n                                        timeout=None, use_proxy=True)\n        resp.raise_for_status()\n        # Loop through returned tenants, looking for a match\n        for tenant in resp.json()[\"items\"]:\n            if tenant[\"displayName\"] == self.tenant_name:\n                self.tenant_key = tenant[\"key\"]\n                self.helper.log_debug(\"Tenant Key = \" + self.tenant_key)\n        return self.tenant_key # None if not found!\n\n    def get_site_id(self) -> str:\n        \"\"\"GET /api/sites/list -- bearer auth + TenantKey header.\"\"\"\n        url = f\"{self.base_url}/api/sites/list\"\n        headers = {\n            \"Content-Type\": \"application/json\",\n            \"Authorization\": f\"Bearer {self.auth_token}\",\n            \"TenantKey\": self.tenant_key,\n        }\n        self.helper.log_debug(\"Getting Site ID...\")\n        resp = self.helper.send_http_request(url, method=\"GET\", parameters=None, payload=None,\n                                        headers=headers, cookies=None, verify=True, cert=None,\n                                        timeout=None, use_proxy=True)\n        resp.raise_for_status()\n        # Loop through sites, looking for a match\n        for site in resp.json()[\"items\"]:\n            if site[\"displayName\"] == self.site_name:\n                self.site_id = site[\"id\"]\n                self.helper.log_debug(\"Site ID = \" + self.site_id)\n        return self.site_id\n\n    def get_live_events(self, page_size: int = 1000) -> dict:\n        \"\"\"GET /api/live-events?siteId=...&pageSize=... -- bearer auth + TenantKey header.\"\"\"\n        url = f\"{self.base_url}/api/live-events\"\n        headers = {\n            \"Accept\": \"application/json\",\n            \"Authorization\": f\"Bearer {self.auth_token}\",\n            \"TenantKey\": self.tenant_key,\n        }\n        params = {\"siteId\": self.site_id, \"pageSize\": page_size}\n        self.helper.log_debug(\"Getting live events....\")\n        resp = self.helper.send_http_request(url, method=\"GET\", parameters=params, payload=None,\n                                        headers=headers, cookies=None, verify=True, cert=None,\n                                        timeout=None, use_proxy=True)\n        resp.raise_for_status()\n        return resp.json()\n\n    def get_reports_live_events(self, page_size: int = 1000, timeout: int = 30) -> dict:\n        \"\"\"GET /api/reports/live-events?siteId=...&pageSize=... -- bearer auth + TenantKey header.\"\"\"\n        url = f\"{self.base_url}/api/reports/live-events\"\n        headers = {\n            \"Accept\": \"application/json\",\n            \"Authorization\": f\"Bearer {self.auth_token}\",\n            \"TenantKey\": self.tenant_key,\n        }\n        params = {\n            \"siteId\": self.site_id, \n            \"pageSize\": page_size,\n            \"page\": 1,\n            \"timeStamp_CloudServerFrom\": self.last_timestamp, \n            \"timeStamp_CloudServerTo\": ((datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=5)).isoformat() if self.last_timestamp else None), # If last_timestamp is None, don't pass CloudServerTo, either\n            \"sortBy\": \"timeStamp_CloudServer\",\n            \"sortOrder\": 0\n            }\n        # print(params)\n        count = 0\n        self.helper.log_info(\"Retrieving live events between \" + (params[\"timeStamp_CloudServerFrom\"] or \"None\") + \" and \" + (params[\"timeStamp_CloudServerTo\"] or \"None\") + \" ...\")\n        while True:\n            resp = self.helper.send_http_request(url, method=\"GET\", parameters=params, payload=None,\n                                        headers=headers, cookies=None, verify=True, cert=None,\n                                        timeout=timeout, use_proxy=True)\n            resp.raise_for_status()\n            j = resp.json()\n            # print(j)\n            # Print out each event as a separate line\n            for item in j[\"items\"]:\n                #print(json.dumps(item))\n                event = self.helper.new_event(json.dumps(item), time=item[\"timeStamp_GMT\"], host=None, index=self.helper.get_output_index(), source=self.helper.get_input_type(), sourcetype=self.helper.get_sourcetype(), done=True, unbroken=True)\n                self.ew.write_event(event)\n                self.last_timestamp = item[\"timeStamp_CloudServer\"] # Update last_timestamp to the latest event\n                self.helper.save_check_point(\"last_timestamp\", self.last_timestamp) # Set checkpoint\n                count += 1\n            self.helper.log_debug(f\"Retrieved {count} events.\")\n            if j[\"page\"] >= j[\"pageCount\"]: # pageCount will return 0 if no items, so we need to allow for that\n                break\n            params[\"page\"] += 1 # Set up to get next page\n\n        return count\n\n    def run_full_flow(self, page_size: int = 1000, timeout: int = 30) -> int:\n        \"\"\"Runs the full chain: token -> tenant key -> site id -> live events.\"\"\"\n        self.connect_token()\n        self.get_tenant_key()\n        self.get_site_id()\n        #return self.get_live_events(page_size=page_size)\n        return self.get_reports_live_events(page_size=page_size, timeout=timeout)\n\n\n\n\ndef validate_input(helper, definition):\n    \"\"\"Implement your own validation logic to validate the input stanza configurations\"\"\"\n    # This example accesses the modular input variable\n    # base_url = definition.parameters.get('base_url', None)\n    # credentials = definition.parameters.get('credentials', None)\n    # page_size = definition.parameters.get('page_size', None)\n    pass\n\ndef collect_events(helper, ew):\n    \"\"\"Implement your data collection logic here\n\n    # The following examples get the arguments of this input.\n    # Note, for single instance mod input, args will be returned as a dict.\n    # For multi instance mod input, args will be returned as a single value.\n    opt_base_url = helper.get_arg('base_url')\n    opt_credentials = helper.get_arg('credentials')\n    opt_page_size = helper.get_arg('page_size')\n    # In single instance mode, to get arguments of a particular input, use\n    opt_base_url = helper.get_arg('base_url', stanza_name)\n    opt_credentials = helper.get_arg('credentials', stanza_name)\n    opt_page_size = helper.get_arg('page_size', stanza_name)\n\n    # get input type\n    helper.get_input_type()\n\n    # The following examples get input stanzas.\n    # get all detailed input stanzas\n    helper.get_input_stanza()\n    # get specific input stanza with stanza name\n    helper.get_input_stanza(stanza_name)\n    # get all stanza names\n    helper.get_input_stanza_names()\n\n    # The following examples get options from setup page configuration.\n    # get the loglevel from the setup page\n    loglevel = helper.get_log_level()\n    # get proxy setting configuration\n    proxy_settings = helper.get_proxy()\n    # get account credentials as dictionary\n    account = helper.get_user_credential_by_username(\"username\")\n    account = helper.get_user_credential_by_id(\"account id\")\n    # get global variable configuration\n    global_userdefined_global_var = helper.get_global_setting(\"userdefined_global_var\")\n\n    # The following examples show usage of logging related helper functions.\n    # write to the log for this modular input using configured global log level or INFO as default\n    helper.log(\"log message\")\n    # write to the log using specified log level\n    helper.log_debug(\"log message\")\n    helper.log_info(\"log message\")\n    helper.log_warning(\"log message\")\n    helper.log_error(\"log message\")\n    helper.log_critical(\"log message\")\n    # set the log level for this modular input\n    # (log_level can be \"debug\", \"info\", \"warning\", \"error\" or \"critical\", case insensitive)\n    helper.set_log_level(log_level)\n\n    # The following examples send rest requests to some endpoint.\n    response = helper.send_http_request(url, method, parameters=None, payload=None,\n                                        headers=None, cookies=None, verify=True, cert=None,\n                                        timeout=None, use_proxy=True)\n    # get the response headers\n    r_headers = response.headers\n    # get the response body as text\n    r_text = response.text\n    # get response body as json. If the body text is not a json string, raise a ValueError\n    r_json = response.json()\n    # get response cookies\n    r_cookies = response.cookies\n    # get redirect history\n    historical_responses = response.history\n    # get response status code\n    r_status = response.status_code\n    # check the response status, if the status is not sucessful, raise requests.HTTPError\n    response.raise_for_status()\n\n    # The following examples show usage of check pointing related helper functions.\n    # save checkpoint\n    helper.save_check_point(key, state)\n    # delete checkpoint\n    helper.delete_check_point(key)\n    # get checkpoint\n    state = helper.get_check_point(key)\n\n    # To create a splunk event\n    helper.new_event(data, time=None, host=None, index=None, source=None, sourcetype=None, done=True, unbroken=True)\n    \"\"\"\n\n    '''\n    # The following example writes a random number as an event. (Multi Instance Mode)\n    # Use this code template by default.\n    import random\n    data = str(random.randint(0,100))\n    event = helper.new_event(source=helper.get_input_type(), index=helper.get_output_index(), sourcetype=helper.get_sourcetype(), data=data)\n    ew.write_event(event)\n    '''\n\n    '''\n    # The following example writes a random number as an event for each input config. (Single Instance Mode)\n    # For advanced users, if you want to create single instance mod input, please use this code template.\n    # Also, you need to uncomment use_single_instance_mode() above.\n    import random\n    input_type = helper.get_input_type()\n    for stanza_name in helper.get_input_stanza_names():\n        data = str(random.randint(0,100))\n        event = helper.new_event(source=input_type, index=helper.get_output_index(stanza_name), sourcetype=helper.get_sourcetype(stanza_name), data=data)\n        ew.write_event(event)\n    '''\n    \n    #helper.set_log_level('debug')\n    # To reset checkpoint: curl -k -u <username>:<password> -X DELETE https://<host>:8089/servicesNS/nobody/TA-keri-borealis/storage/collections/data/TA_keri_borealis_checkpointer\n    \n    opt_base_url = helper.get_arg('base_url')\n    opt_credentials = helper.get_arg('credentials')\n    opt_tenant_name = helper.get_arg('tenant_name')\n    opt_site_name = helper.get_arg('site_name')\n    opt_page_size = helper.get_arg('page_size')\n    opt_timeout = int(helper.get_arg('timeout'))\n    opt_start = helper.get_arg('timestamp_start')\n    last_timestamp = helper.get_check_point('last_timestamp') or opt_start # use checkpoint if exists\n    \n    client = BorealisClient(helper, ew, opt_base_url, opt_credentials[\"username\"], opt_credentials[\"password\"], opt_tenant_name, opt_site_name, last_timestamp)\n    count = client.run_full_flow(page_size=opt_page_size, timeout=opt_timeout)\n    helper.log_info(f\"Retrieved {count} events.\")\n    \n", "customized_options": [{"name": "base_url", "value": "https://apikeri-modern.aetheros.net"}, {"name": "credentials", "value": "account0"}, {"name": "tenant_name", "value": "Tek Stream"}, {"name": "site_name", "value": "TekStream"}, {"name": "page_size", "value": "1000"}, {"name": "timeout", "value": "30"}, {"name": "timestamp_start", "value": "2026-07-01T00:00:00+00:00"}], "uuid": "2388c3a1e8c744b7a3ea710f20f1573a", "sample_count": "3220"}]}, "field_extraction_builder": {"borealis": {"data_format": "unstructured_data", "is_parsed": true, "regex_results": {"status": {"finished": true, "progress": 1.0}, "groups": [{"group_id": "pattern_0", "seed": {"raw": "{\"messageTypeGroup\": \"Reader\", \"messageType\": \"EVT_Door_Unlock\", \"timeStamp_CloudServer\": \"2026-07-10T15:43:19.366741+00:00\", \"timeStamp_GMT\": \"2026-07-10T15:43:15+00: