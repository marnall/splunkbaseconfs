# Application-level permissions
#
# SA-Eventgen discovers eventgen.conf by scanning app directories, and Splunk
# docs for it recommend running the generating app globally. Exporting to
# system keeps that behaviour consistent for stanzas authored here.

[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[eventgen]
access = read : [ admin, sc_admin, power ], write : [ admin, sc_admin ]
export = system

[views]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[nav]
access = read : [ * ], write : [ admin, sc_admin ]
export = system
