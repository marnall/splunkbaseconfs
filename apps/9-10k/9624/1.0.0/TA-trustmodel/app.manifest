    "releaseDate": null,
    "description": "Receives TrustModel AI evaluation lifecycle events and findings via HTTP Event Collector, parses them as Splunk Common Information Model (CIM) data, and tags high-severity findings for Splunk Enterprise Security alert workflows. Adds CIM field extractions, search macros, and event-type tagging so TrustModel risk signals surface natively in ES Incident Review, Risk-Based Alerting, and ITSI alongside other security telemetry — no per-customer Splunk configuration required.",
    "classification": {
      "intendedAudience": "IT",
      "categories": ["IT Operations", "Security, Fraud & Compliance"],
      "developmentStatus": "Production/Stable"
    },
    "commonInformationModels": {
      "Alerts": "5.0",
      "Performance": "5.0"
    },
    "license": {
