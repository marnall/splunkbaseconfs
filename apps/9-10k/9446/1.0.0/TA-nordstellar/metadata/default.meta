# sc_admin is the Splunk Cloud equivalent of admin; without it, Cloud customers
# cannot edit these knowledge objects.
[]
access = read : [ * ], write : [ admin, sc_admin ]

# Parsing/knowledge objects are shared system-wide so NordStellar events are
# parsed and searchable from any app, not just this TA.
[props]
export = system

[eventtypes]
export = system

[tags]
export = system