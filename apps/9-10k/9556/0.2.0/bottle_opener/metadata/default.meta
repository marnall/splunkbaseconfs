# Access controls for PTK Bottle Opener
#
# The certcheck command reads SSL/TLS certificate files and Splunk
# configuration directly from the filesystem.  It must not be exposed to
# unprivileged users.  Only the built-in administrative roles receive access;
# add additional roles below if your deployment uses custom admin roles.
#
# Syntax reminder:
#   access = read : [ <role>, ... ], write : [ <role>, ... ]
#   export = system   -> available across all apps
#   export = none     -> available only within this app (default)

[]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

[commands/certcheck]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system
