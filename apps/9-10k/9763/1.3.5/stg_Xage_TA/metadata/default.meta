# Export knowledge objects system-wide so CIM eventtypes/tags/macros/lookups
# are visible to the CIM add-on, Enterprise Security, and the stg_Xage app.
# Explicit stanzas: a bare [] export is not always applied to every KO class
# on SHC / Cloud, which left App dashboards with unknown `xage` / empty tags.
# sc_admin is required for Splunk Cloud (AppInspect check_kos_are_accessible).

[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[macros]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[eventtypes]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[tags]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[lookups]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms]
access = read : [ * ], write : [ admin, sc_admin ]
export = system
