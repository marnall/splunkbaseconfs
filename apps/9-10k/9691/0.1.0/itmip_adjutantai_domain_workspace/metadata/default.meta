# Application-level permissions.
# The two views stay app-scoped on purpose: nothing in this preview needs to be
# visible from other apps, and a globally exported view named "about" would
# collide with other apps.
# sc_admin is the Splunk Cloud equivalent of admin; without it, Cloud customers
# could not administer this app's objects.
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none
