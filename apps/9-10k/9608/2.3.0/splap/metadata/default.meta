# Least-privilege metadata. All app objects readable by every role that can see the app;
# only admin and power may modify. Nothing is exported globally.
[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

[views]
access = read : [ * ], write : [ admin, sc_admin, power ]

[nav]
access = read : [ * ], write : [ admin, sc_admin ]

[lookups]
access = read : [ * ], write : [ admin, sc_admin, power ]

[transforms]
access = read : [ * ], write : [ admin, sc_admin, power ]

[macros]
access = read : [ * ], write : [ admin, sc_admin, power ]

[savedsearches]
access = read : [ * ], write : [ admin, sc_admin, power ]
