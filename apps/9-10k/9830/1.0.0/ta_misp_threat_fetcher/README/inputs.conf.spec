[misp_threat_events://<name>]
historical_polling_days = Days to look back on first run (1-365). (Default: 30)
index = (Default: default)
interval = Polling interval in seconds [300s - 31536000s]. (Default: 300)
misp_api_key = MISP API authkey (Administration > List Users > Authkey).
misp_url = Full URL of your MISP instance (e.g., https://misp.corp.com). No trailing slash.
