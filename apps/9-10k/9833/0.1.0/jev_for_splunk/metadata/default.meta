# The command, its question sets and its cache are usable from every app.
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Anyone may be served from the cache; only trusted roles may write it, because a forged entry
# would be returned to everyone as the model's answer. A role without write access still gets
# answers, with a warning that they were not cached.
[collections/jev_cache]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system
