# App-level: everyone can read (required for cross-app script/stylesheet
# references), admins manage.
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# The custom visualizations must be visible from every app's dashboards
# (the picker is fed from the dashboard's app context); their static
# assets resolve through the app-level read above.
[visualizations]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Demo collection: writable by admins out of the box. Exported so the demo
# lookup can feed tables on dashboards in other apps.
[collections/kv_editor_demo]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms/kv_editor_demo_lookup]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[views/kv_editor_demo]
access = read : [ * ], write : [ admin, sc_admin ]

