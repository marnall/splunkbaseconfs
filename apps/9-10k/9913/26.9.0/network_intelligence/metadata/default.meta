[]
owner = admin
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# NI-180: general NI UI pages, restricted to the NI capability roles
# (authorize.conf) and platform admins.
[views/home]
access = read : [ ni_read_only, ni_scoped_read, ni_restricted_admin, ni_admin, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[views/alerts]
access = read : [ ni_read_only, ni_scoped_read, ni_restricted_admin, ni_admin, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[views/sites]
access = read : [ ni_read_only, ni_scoped_read, ni_restricted_admin, ni_admin, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[views/unified_inventory]
access = read : [ ni_read_only, ni_scoped_read, ni_restricted_admin, ni_admin, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# NI-176: admin-only settings page (enable/disable data sources, indexes,
# collection interval). Restricted to the roles that hold ni_config_manage
# (authorize.conf) -- narrower than the read-oriented views above, which also
# admit ni_read_only/ni_scoped_read.
[views/configuration]
access = read : [ ni_restricted_admin, ni_admin, admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# NI KV Store collections (default/collections.conf). Server-side only, per
# NI-92: system_authtoken backs every KV query/search/conf op, so no ni_*
# role needs direct read access.
[collections/ni_vertices]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[collections/ni_edges]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[collections/ni_capability_state]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[collections/ni_vertex_mappings]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[collections/ni_alert_snapshots]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# RBAC policy storage (docs/rbac/visibility-layer.md § Schema).
[collections/ni_rbac_policies]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[collections/ni_rbac_config]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[datamodels]
export = system

[eventtypes]
export = system

[lookups]
export = system

[macros]
export = system

[props]
export = system

[tags]
export = system

[transforms]
export = system
