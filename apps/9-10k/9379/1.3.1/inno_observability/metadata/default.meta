## 앱 객체 권한
##  - 뷰/lookup 등: 앱 전용(app 스코프). search 앱 컨텍스트로 새지 않게(일원화 — 구 search 앱 경로 차단).
##  - 매크로: 드릴다운(돋보기 → search 앱 검색)에서 풀려야 하므로 system 으로 export.
[]
access = read : [ * ], write : [ admin, sc_admin, power ]

[macros]
export = system

## 카테고리 분류 룩업(키워드 패턴→카테고리) — 돋보기(Search 앱)에서 카테고리별 SPL이 풀리도록 export.
##  카테고리 키워드 매핑이라 민감정보 아님. infra_role_overrides(KV)도 같은 이유로 export.
[transforms/infra_cat_kw]
export = system

[transforms/infra_role_overrides]
export = system

[lookups/infra_cat_kw.csv]
export = system

## 호스트→카테고리 완성 맵(infra_host_category_gen 저장검색이 매일 생성). 대시보드/돋보기에서 `lookup infra_host_category` 가 풀리도록 export.
[transforms/infra_host_category]
export = system

[lookups/infra_host_category.csv]
export = system

## OTel Agent 인벤토리/상태(②설계서 P0, 2026-07-27) — otel_agent_health(5분)가 채우는 KV.
##  대시보드(agent_fleet/agent_inventory/agent_detail)와 돋보기(Search 앱) 양쪽에서
##  `| inputlookup otel_agent_status` 가 풀려야 하므로 export(호스트 메타·상태만, 시크릿 없음).
[transforms/otel_agent_status]
export = system

[transforms/otel_agent_roster]
export = system

## K8s 배포 원장(Phase 1, 2026-07-28) — k8s_deploy_ledger_gen(5분)이 채우는 KV.
##  ⚠ export 필수: Studio 게시본(k8s_deploy_timeline)의 타일은 브라우저에서
##  `/splunkd/__raw/search/jobs/export`(비네임스페이스) 로 SPL을 돌리므로 앱 스코프
##  룩업은 "lookup table is invalid" 로 실패한다(실측). 돋보기(Search 앱)도 동일.
##  설정 메타데이터(이미지·env 키 이름·리소스)만 담고 시크릿 값은 없음.
[transforms/k8s_deploy_ledger]
export = system

## ConfigMap 내용 이력(Phase 3) — 같은 이유로 export(대시보드가 브라우저에서 비네임스페이스로 조회).
[transforms/k8s_configmap_history]
export = system

## 카테고리 설정 페이지 — 관리자 전용(읽기·쓰기 모두 admin/sc_admin). 비관리자는 nav 미노출 + 접근 차단.
[views/infra_categories]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

## 분류 관리자 페이지 — 같은 관리자 CRUD 화면이라 동일하게 막는다(2026-07-31).
## ⚠ 이 스탠자가 없으면 앱 기본값 [] = read:[*] 로 떨어져 **일반 user 롤도 열 수 있었다**(실측).
##   apm_gate.js 의 BLOCKED_VIEWS 는 *라이선스* 게이트라 유료 키가 있으면 열리므로 권한 차단이 될 수 없다.
[views/infra_admin]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

## ── 라이선스 ─────────────────────────────────────────────
## 게이트 커맨드 `| innolicense` — 모든 사용자가 실행해야 하므로 read 는 전체 개방.
## 상태만 반환하고 키는 절대 반환하지 않으므로 개방해도 노출 없음.
[commands/innolicense]
access = read : [ * ], write : [ admin, sc_admin ]
## 전역 export (2026-07-31 사용자 결정) — 어느 앱의 검색창에서도 `| innolicense` 를 쓸 수 있게.
## ⚠ 예전 규칙은 "export = system 금지"였다. 이유는 `inno_dashboard_studio` 가 **같은 커맨드명**을
##   싣기 때문이었고, 둘 다 전역 export 하면 PRODUCT(앱 디렉터리명에서 유도)가 엉뚱하게 잡힐 수
##   있었다. 2026-07-30 Studio 단일 앱 통합으로 studio 앱이 제거돼 그 전제가 사라졌다.
## ⚠ **studio 앱 사본은 앱 스코프로 남겨둘 것** — 두 앱이 함께 설치돼도 전역 이름이 하나뿐이라
##   `| innolicense` 가 항상 이 앱으로 결정적으로 해석된다. 양쪽을 export 하면 다시 충돌한다.
export = system


[commands/innocore]
access = read : [ * ], write : [ admin, sc_admin ]
## 🔴 전역 export 필수 (2026-08-01, 실화면에서 발견) — Studio 렌더러(`APMStudio.runSPL`)는
##   **비네임스페이스** `/search/jobs/export` 로 SPL 을 돌린다. 앱 스코프로 두면 게시된 보드의
##   Fleet Map 이 `Unknown search command 'innocore'` 로 뜬다(검색창에서 `-app` 을 주면 되는데
##   화면만 깨져서, CLI 로 테스트하면 통과하고 대시보드만 실패하는 전형적 함정이다).
##   같은 이유로 `innolicense` 도 전역이다. 렌더러를 네임스페이스 호출로 바꾸는 게 더 옳지만
##   전 차트에 영향이 가므로, 지금은 커맨드 쪽에서 해결한다.
## 무면허·코어 부재여도 이 커맨드는 `available/licensed` 만 돌려주므로 개방해도 새지 않는다
## (프리미엄 판정은 코어가 하고, 스펙은 라이선스가 있어야만 나온다).
export = system


## 무면허면 커맨드 자체가 `locked` 한 행만 돌려주므로 개방해도 프리미엄이 새지 않는다
## (게이팅은 ACL 이 아니라 자산 키 보유 여부로 한다).

[inno_license]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

## 라이선스 설정 페이지 — 관리자 전용. 키 입력/교체는 admin 만.
## (게이트 커맨드 `| innolicense` 자체는 전 사용자 read 이므로 대시보드 게이팅은 정상 동작한다.)
## 설정 페이지 — 관리자 전용. RCA 모드/LLM 연결을 바꾸면 전 사용자 화면에 영향을 주므로
## 일반 user 롤에 열어두면 안 된다(라이선스 뷰와 같은 기준).
[views/settings]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

[views/license]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

## 설치 설정 화면 — 인덱스 지정 + 수집 시작.
## ⚠ 여기에 **라이선스 게이트를 걸지 않는다**(apm_gate.js BLOCKED_VIEWS 에 넣지 말 것).
##   게이트는 "돈 낸 기능"을 막는 장치이고, 인덱스 설정은 제품을 쓸 수 있게 만드는 설치
##   단계다. settings 처럼 게이트를 걸면 무료 티어 고객이 인덱스를 못 정해 앱이 설치 직후
##   죽는다 — 무료 배포 모델과 정면 충돌. 접근 제한은 이 ACL 이 담당한다.
[views/setup]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]

## 데이터 준비도 — 평가자가 자기 데이터로 "이게 되나"를 확인하는 화면.
## ⚠ **의도적으로 전체 공개다** (license·setup 과 다르다). 키가 없는 평가자와 관리자가
##   아닌 담당자가 봐야 구매 판단이 된다. 여기를 관리자 전용으로 좁히지 말 것 —
##   좁히는 순간 무료 배포의 전환 경로가 끊긴다.
## ⚠ 판정은 **보는 사람의 인덱스 권한 범위**에서 이뤄진다(`index=*` 는 권한을 넘지 못한다).
##   권한이 좁은 사용자는 "데이터 없음"으로 볼 수 있어, 화면이 그 사실을 함께 안내한다.
[views/readiness]
access = read : [ * ], write : [ admin, sc_admin ]

## APM 이름 위생(2026-08-10) — agent_fleet 카드와 돋보기(Search 앱) 양쪽에서
##  `| inputlookup apm_naming_status` 가 풀려야 하므로 export(서비스명·집계수치만, 시크릿 없음).
[transforms/apm_naming_status]
export = system

## 사라진 요청(blackhole, 2026-08-14) — 저장검색 3종이 채우는 KV 3종.
##  🔴 export = system 이 **필수**다. Studio 렌더러는 **비네임스페이스** `/search/jobs/export` 로 SPL 을
##  돌리므로 앱 스코프 룩업이 "lookup table is invalid" 로 실패한다 — 그런데 인덱스를 읽는 패널은
##  멀쩡히 그려져서 "일부만 깨진" 화면이 되고, 원인을 데이터 쪽에서 찾게 된다(k8s 보드에서 이미 한 번 당했고
##  이번에도 똑같이 당했다). 담기는 것은 호스트·서비스명과 커널 카운터뿐으로 시크릿 없음.
[transforms/blackhole_verdicts]
export = system

[transforms/blackhole_peer_roster]
export = system

[transforms/blackhole_hostnet]
export = system

[transforms/blackhole_podnet]
export = system

[transforms/blackhole_podkern]
export = system

[transforms/blackhole_podnet_node]
export = system

[transforms/blackhole_vmnet]
export = system

[transforms/blackhole_sockpeer]
export = system

[transforms/blackhole_peerconn]
export = system

# AI 연결 카탈로그 — 관리자만. 백엔드 주소가 들어 있어 일반 사용자에게 열 이유가 없다.
[collections/inno_ai_connections]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[transforms/inno_ai_connections]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
