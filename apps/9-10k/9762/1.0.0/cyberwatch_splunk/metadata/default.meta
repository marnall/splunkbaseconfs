#
# This app grants no capability to any role. Reading its dashboards needs
# access to the index the add-on writes to, which is an administrative act on
# the index, not something an app can or should hand out.

# sc_admin sits beside admin everywhere: a Splunk Cloud customer never has the
# admin role, so a grant that names only admin gives their administrators
# nothing. AppInspect warns about it; the warning is right.

[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

# The macros are the app's integration point: an administrator edits
# cyberwatch_index once, and anyone writing their own searches should be able to
# reuse `cyberwatch_exposure` rather than rediscover the incremental-collection
# rule it encodes. That is worth a global export; nothing else here is.
[macros]
export = system
access = read : [ * ], write : [ admin, sc_admin, power ]
