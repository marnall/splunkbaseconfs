[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[props]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[eventtypes]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[tags]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Passwords stored under this app's realm (e.g. the OCI key passphrase)
# stay private to this app rather than being globally readable.
[storage/passwords]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none
