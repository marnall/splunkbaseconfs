# Everyone can see the app and its views.
[]
access = read : [ user,* ], write : [ admin, sc_admin ]
export = none

# Everyone can read scores; only the queens endpoints (and admins) write them.
[collections/queens_scores]
access = read : [ user,* ], write : [ admin, sc_admin ]
export = system

# Game sessions are private to the endpoints (and admins).
[collections/queens_sessions]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[transforms/queens_scores_lookup]
access = read : [ user,* ], write : [ admin, sc_admin ]
export = system
