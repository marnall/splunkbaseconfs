[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[views/*]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[nav/*]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# LookupOps collections are private to the app; access flows through the
# capability-checked REST layer, not direct KV reads from other apps.
[collections/*]
access = read : [ * ], write : [ * ]
export = none
