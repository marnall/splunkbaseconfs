# Application-level permissions.
#
# collections.conf carries no access settings at all, so a KV store collection
# that is not given an ACL here is simply invisible -- and a KV store access
# refusal surfaces as a 404, not a 403, which makes that mistake look exactly
# like a wrong collection name.

[]
owner = admin
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# -- Reference data ----------------------------------------------------------
# Readable by everyone so the lookups resolve for any user running a search,
# and so the companion dashboard app can read them. Written only by the add-on,
# which runs with the system context: nothing a browser does should be able to
# change reference data.

[collections/cyberwatch_cve]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[collections/cyberwatch_compliance_rule]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms/cyberwatch_cve_lookup]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms/cyberwatch_compliance_rule_lookup]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# -- Internal state ----------------------------------------------------------
# Input checkpoints. Not reference data, not useful outside the add-on, and
# readable only by administrators: it holds the shape of the estate.

[collections/ta_cyberwatch_checkpoints]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none
