{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$comment": "Interchange schema for the Federal AI Agent Assurance Agent Release Manifest 1.0. Runtime validation is the explicit stdlib code in faaa_lib/manifest.py; this document is for tooling and documentation. The $schema URI is an identifier, not a runtime fetch.",
 "title": "Agent Release Manifest",
 "type": "object",
 "required": [
  "schema_version",
  "identity",
  "governance",
  "model",
  "execution"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "identity": {
   "type": "object",
   "required": [
    "agent_id",
    "agent_name",
    "release_version",
    "owner",
    "mission"
   ]
  },
  "governance": {
   "type": "object",
   "required": [
    "impact_level",
    "impact_rationale",
    "reassessment_interval_days"
   ]
  },
  "model": {
   "type": "object",
   "required": [
    "provider",
    "model_id"
   ]
  },
  "instructions": {
   "type": "object"
  },
  "knowledge": {
   "type": "array"
  },
  "lookup_dependencies": {
   "type": "array"
  },
  "mcp_tools": {
   "type": "array"
  },
  "splunk_access": {
   "type": "object"
  },
  "execution": {
   "type": "object",
   "required": [
    "permitted_side_effects"
   ]
  },
  "memory": {
   "type": "object"
  },
  "tevv": {
   "type": "object"
  },
  "authorization_request": {
   "type": "object"
  },
  "extensions": {
   "type": "object"
  }
 }
}