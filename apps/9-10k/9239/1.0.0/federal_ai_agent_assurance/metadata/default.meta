[]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[views/*]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[nav/*]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

# Collections are private to the app; access flows through the
# capability-checked REST layer, never direct cross-app KV reads.
[collections/*]
access = read : [ * ], write : [ * ]
export = none
