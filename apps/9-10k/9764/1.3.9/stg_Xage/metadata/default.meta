# Export saved searches and macros so Enterprise Security Content Management
# can see correlation searches. Views/nav stay app-local.
# sc_admin is required for Splunk Cloud (AppInspect check_kos_are_accessible).

[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[macros]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[savedsearches]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[views]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[nav]
access = read : [ * ], write : [ admin, sc_admin ]
export = none
