# Everything in the app is readable by every role and writable by admin
# (sc_admin on Splunk Cloud, where there is no admin role);
# the objects are exported globally so the indexes, sourcetypes and lookup
# resolve from the Search app and from Secure Gateway too.

[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[views]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[nav]
access = read : [ * ], write : [ admin, sc_admin ]
export = none

[savedsearches]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[lookups]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[transforms]
export = system

[props]
export = system

[indexes]
export = system

[macros]
access = read : [ * ], write : [ admin, sc_admin ]
export = system
