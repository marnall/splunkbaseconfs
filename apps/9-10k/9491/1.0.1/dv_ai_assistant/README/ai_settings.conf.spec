@placement search-head

[global_settings]
auto_triage = <boolean>
* Enable or disable automatic notable-event triage.

auto_interval = <integer>
* Automatic triage polling interval in seconds.

language = <string>
* Response language code. Supported application values: auto, en, tr, de, fr, es, it, pt, nl, pl, ru, ar, ja, ko, zh.
